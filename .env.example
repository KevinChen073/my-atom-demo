# Copy to .env for local development; never commit real credentials.
APP_ENV=local
# Optional local PostgreSQL persistence smoke after explicit migration.
# MYATOM_DATABASE_URL=postgresql://myatom_writer:password@127.0.0.1:5432/myatom?sslmode=require
# Azure secret only; do not put an actual connection string in this file.
# MYATOM_AZURE_SQL_CONNECTION_STRING=Server=tcp:example.database.windows.net,1433;Database=my-atom;Encrypt=yes;TrustServerCertificate=no;UID=myatom_writer;PWD=replace-me
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com
MODEL_REASONING_EFFORT=high
MODEL_CODE_REASONING_EFFORT=none
# 仅供已验证邀请码的平台测试额度使用；普通模式不会回填或自动使用。
MODEL_API_KEY=
# Trusted demo: configure one invitation code; a short code is easy to guess.
# MYATOM_INVITE_CODE=<invitation-code>
# MYATOM_INVITE_DAILY_MODEL_CALLS=120
# MYATOM_INVITE_DAILY_TOKENS=1000000
MAX_MODEL_CALLS=80
MAX_TOTAL_TOKENS=100000
MAX_RUN_SECONDS=900
MAX_FIX_ROUNDS=60
PREVIEW_PORT=8001
WORKBENCH_ORIGIN=http://127.0.0.1:8000
