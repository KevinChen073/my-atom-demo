# Set these in the Atoms private environment, never in the repository or browser bundle.
APP_ENV=atom
ATOM_ACCESS_TOKEN=
MODEL_API_KEY=
MODEL_NAME=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com
WORKBENCH_ORIGIN=https://app.example.com
MYATOM_DATA_DIR=/persistent/myatom
# Enable only after verifying wildcard DNS, TLS, Host forwarding and browser isolation.
# ATOM_PREVIEW_DOMAIN=preview.example.com
ATOM_PREVIEW_SCHEME=https
HOST=0.0.0.0
PORT=8000
