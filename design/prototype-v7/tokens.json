{
  "meta": {
    "name": "MYATOM desktop prototype typography",
    "version": "v7",
    "inherits": "../v3/tokens.json"
  },
  "visualIdentity": {
    "mark": "../v3/icons/brand-mark.svg",
    "lockup": "../v3/icons/brand-lockup.svg",
    "agentAvatarPx": 30
  },
  "typography": {
    "family": {
      "body": "PingFang SC, Microsoft YaHei, Noto Sans CJK SC, system-ui, sans-serif",
      "display": "Songti SC, SimSun, serif",
      "mono": "Cascadia Code, ui-monospace, monospace"
    },
    "sizesPx": {
      "auxiliary": 14,
      "meta": 15,
      "label": 16,
      "compact": 17,
      "body": 18,
      "emphasis": 19,
      "smallHeading": 21,
      "card": 24,
      "section": 26,
      "page": 34,
      "hero": 50
    },
    "lineHeight": { "body": 1.62, "heading": 1.24 }
  }
}
