{
  "meta": {
    "name": "MYATOM desktop design tokens",
    "version": "v7",
    "status": "approved-current-design-prototype",
    "platform": "desktop-web",
    "referencePrototype": "prototype-v7/",
    "notes": "V7 已由用户确认为当前设计原型。本文件记录其设计值；原型 CSS 尚未自动读取本文件。正式产品同步时须核对 PRD 差异与实际实现。"
  },
  "color": {
    "canvas": "#F5F4EF",
    "surface": "#FFFEFA",
    "navigation": "#F0F1EB",
    "surfaceSoft": "#F4F5F0",
    "ink": "#172522",
    "muted": "#52645B",
    "quiet": "#69776E",
    "line": "#D7DED6",
    "lineStrong": "#BDC9BE",
    "brand": "#245C50",
    "brandHover": "#1D4B41",
    "brandSoft": "#E7F0EA",
    "decision": "#A64B2B",
    "decisionHover": "#873C21",
    "decisionSoft": "#F8EBE3",
    "success": "#245F52",
    "warning": "#89501F",
    "danger": "#A43D34",
    "focus": "#2A6D61",
    "white": "#FFFFFF",
    "previewCanvas": "#E8EBE9"
  },
  "typography": {
    "family": {
      "body": "PingFang SC, Microsoft YaHei, Noto Sans CJK SC, system-ui, sans-serif",
      "display": "Songti SC, SimSun, serif",
      "mono": "Cascadia Code, ui-monospace, monospace"
    },
    "sizesPx": {
      "auxiliary": 14,
      "meta": 15,
      "label": 16,
      "compact": 17,
      "body": 18,
      "emphasis": 19,
      "smallHeading": 21,
      "card": 24,
      "section": 26,
      "page": 34,
      "hero": 50
    },
    "lineHeight": {
      "body": 1.62,
      "heading": 1.24
    },
    "weight": {
      "regular": 400,
      "medium": 550,
      "semibold": 650,
      "bold": 700
    }
  },
  "spacingPx": [4, 8, 12, 16, 24, 32, 48, 64],
  "radiusPx": {
    "control": 8,
    "card": 12,
    "preview": 14,
    "composer": 16,
    "pill": 999
  },
  "shadow": {
    "homeComposer": "0 14px 40px #2542330D",
    "homeComposerFocus": "0 0 0 3px #DFECE1, 0 14px 40px #2542330D"
  },
  "componentStates": {
    "navigationSelected": "brand text + brandSoft surface + visible underline or side rule",
    "decisionRequired": "decision text + decisionSoft surface + action label",
    "success": "success text + explicit status label",
    "disabled": "disabled control + clear unavailable reason where needed",
    "focusVisible": "focus outline independent of hover animation"
  },
  "layout": {
    "targetViewports": ["1280x720", "1366x768", "1440x900"],
    "sidebarDefaultPx": 220,
    "sidebarRangePx": [180, 280],
    "chatDefaultPercentOfWorkspace": 56,
    "chatRangePercentOfWorkspace": [42, 64],
    "chatVisibleMinPx": 440,
    "rightVisibleMinPx": 400,
    "rightNavigationHeightPx": 52,
    "homeContentMaxPx": 760,
    "homeStarterCards": 3
  },
  "visualIdentity": {
    "brandMark": "v3/icons/brand-mark.svg",
    "brandLockup": "v3/icons/brand-lockup.svg",
    "agentAvatarPx": 30,
    "iconGridPx": 20,
    "iconStrokePx": 1.75
  },
  "motionMs": {
    "hover": 120,
    "popover": 180,
    "rightPanel": 160,
    "feedback": 220,
    "heroTypingPerCharacter": 125,
    "heroDeletingPerCharacter": 72,
    "heroCompletedPause": 1650,
    "heroBetweenPhrases": 360,
    "heroInitialDelay": 280,
    "heroCaretBlink": 900
  },
  "focus": {
    "outlineWidthPx": 3,
    "outlineOffsetPx": 3
  },
  "reducedMotion": {
    "heroText": "今天想做什么？",
    "heroCaretVisible": false,
    "spatialTransitions": "instant"
  }
}
