# Independent operations service. Copy to ops/.env and set an absolute shared DB path.
OPS_DB_PATH=D:/projects/my-atom-demo/data/myatom.sqlite3
# Legacy local PostgreSQL smoke: configure OPS_DATABASE_URL with a read-only role.
# OPS_DATABASE_URL=postgresql://ops_reader:password@host:5432/myatom?sslmode=require
# Azure SQL: leave OPS_DB_PATH and OPS_DATABASE_URL empty; use a separate account with SELECT on four ops_* views only.
# OPS_AZURE_SQL_CONNECTION_STRING=Server=tcp:example.database.windows.net,1433;Database=my-atom;Encrypt=yes;TrustServerCertificate=no;UID=ops_reader;PWD=replace-me
OPS_ADMIN_KEY=replace-with-a-long-random-value
OPS_HOST=127.0.0.1
OPS_PORT=8002
