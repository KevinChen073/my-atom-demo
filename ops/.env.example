# Independent operations service. Copy to ops/.env and set an absolute shared DB path.
OPS_DB_PATH=D:/projects/my-atom-demo/data/myatom.sqlite3
# Azure: configure OPS_DATABASE_URL with a dedicated read-only role and leave OPS_DB_PATH empty.
# OPS_DATABASE_URL=postgresql://ops_reader:password@host:5432/myatom?sslmode=require
OPS_ADMIN_KEY=replace-with-a-long-random-value
OPS_HOST=127.0.0.1
OPS_PORT=8002
